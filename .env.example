POSTGRES_DB=infobridge
POSTGRES_USER=infobridge
POSTGRES_PASSWORD=infobridge_dev_password
DATABASE_URL=postgresql+psycopg://infobridge:infobridge_dev_password@localhost:5432/infobridge
API_CORS_ORIGINS=http://localhost:5173,https://infobridge-frontend-production.up.railway.app
VITE_API_URL=http://localhost:8000/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_FAILURE_LOCK_THRESHOLD=5
AUTO_ARCHIVE_AFTER_DAYS=30
DEFAULT_RETENTION_DAYS=3650
DOCUMENT_PURGE_ENABLED=false
LIFECYCLE_WORKER_ENABLED=true
LIFECYCLE_SCAN_INTERVAL_SECONDS=3600
DUE_ALERTS_ENABLED=true
DUE_SOON_HOURS=24
MINIO_ROOT_USER=infobridge
MINIO_ROOT_PASSWORD=infobridge_minio_password
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_ENCRYPTION_PROVIDER=fernet
DOCUMENT_ENCRYPTION_KEYS={}
DOCUMENT_ACTIVE_ENCRYPTION_KEY_ID=
AWS_KMS_KEY_ID=
AWS_KMS_REGION=us-east-1
AWS_KMS_ENDPOINT_URL=
AWS_KMS_ACCESS_KEY_ID=
AWS_KMS_SECRET_ACCESS_KEY=
AWS_KMS_SESSION_TOKEN=
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=infobridge-documents
S3_ACCESS_KEY_ID=infobridge
S3_SECRET_ACCESS_KEY=infobridge_minio_password
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true
DOCUMENT_MAX_UPLOAD_BYTES=26214400

# Password recovery: trusted frontend address used to create reset links.
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
# Configure these on the backend to enable self-service recovery by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# false: STARTTLS (587); true: implicit TLS (usually 465).
SMTP_SSL=false
